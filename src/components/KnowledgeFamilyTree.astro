---
import {
  getEntity, one, parents, children, partners, siblings, betrothed,
  DEFAULT_DATE, type Moment, type Entity
} from '../data/knowledge/index';

interface Props { personId?: string; houseId?: string; asOf?: Moment; }
const { personId, houseId, asOf = DEFAULT_DATE } = Astro.props;
const focus = personId ? getEntity(personId) : houseId ? one(houseId, 'head', asOf) : undefined;
const unique = (people: Entity[]) => [...new Map(people.map(p => [p.id,p])).values()];
const sort = (people: Entity[]) => unique(people).sort((a,b) => a.name.localeCompare(b.name));
const relatives = (person: Entity) => ({
  parents: sort(parents(person.id, asOf)),
  spouses: sort(partners(person.id, asOf)),
  betrothed: sort(betrothed(person.id, asOf)),
  siblings: sort(siblings(person.id, asOf)),
  children: sort(children(person.id, asOf))
});
const main = focus ? relatives(focus) : undefined;
// Include collateral and affinal branches without following an unbounded graph.
// Each row describes one person's own relationships, never inferred marriages
// or common parentage for explicitly attested siblings or half-siblings.
const branches = focus && main ? unique([
  ...main.parents, ...main.spouses, ...main.siblings, ...main.children,
  ...main.parents.flatMap(p => siblings(p.id, asOf)),
]).filter(p => p.id !== focus.id).map(person => ({person, links:relatives(person)})) : [];
const groups = (links: ReturnType<typeof relatives>) => [
  {label:'Parents', people:links.parents},
  {label:'Spouses', people:links.spouses},
  {label:'Betrothed', people:links.betrothed},
  {label:'Siblings', people:links.siblings},
  {label:'Children', people:links.children},
].filter(group => group.people.length > 0);
---
<section class="orr-genealogy-panel orr-knowledge-tree" aria-label={focus ? 'Family of '+focus.name : 'Recorded genealogy'}>
  {focus && main ? (
    <>
      <div class="tree-caption">Recorded family in {asOf.year} AC{asOf.chapter ? ' · Chapter '+asOf.chapter : ''}</div>
      <div class="tree-primary">
        {main.parents.length > 0 && (
          <div class="tree-tier">
            <span class="tree-label">Parents</span>
            <div class="tree-nodes">{main.parents.map(p => p.page ? <a class="tree-node" href={p.page}>{p.name}</a> : <span class="tree-node">{p.name}</span>)}</div>
          </div>
        )}
        <div class="tree-focus">{focus.page ? <a class="tree-node tree-current" href={focus.page}>{focus.name}</a> : <span class="tree-node tree-current">{focus.name}</span>}</div>
        {groups(main).filter(g => g.label !== 'Parents').map(group => (
          <div class="tree-tier">
            <span class="tree-label">{group.label}</span>
            <div class="tree-nodes">{group.people.map(p => p.page ? <a class="tree-node" href={p.page}>{p.name}</a> : <span class="tree-node">{p.name}</span>)}</div>
          </div>
        ))}
        {groups(main).length === 0 && <p class="tree-caption">No family relationships have yet been recorded for this person.</p>}
      </div>
      {branches.length > 0 && (
        <div class="tree-branches">
          <div class="tree-caption">Connected family branches</div>
          {branches.map(({person,links}) => (
            <details class="tree-branch" open={houseId ? true : undefined}>
              <summary>{person.name}</summary>
              <div class="tree-branch-content">
                {person.page && <a class="tree-profile" href={person.page}>Biography</a>}
                {groups(links).map(group => (
                  <div class="tree-tier">
                    <span class="tree-label">{group.label}</span>
                    <div class="tree-nodes">{group.people.map(p => p.page ? <a class="tree-node" href={p.page}>{p.name}</a> : <span class="tree-node">{p.name}</span>)}</div>
                  </div>
                ))}
              </div>
            </details>
          ))}
        </div>
      )}
      <p class="tree-caption">Only recorded relationships are shown. A shared sibling does not establish identical parents; betrothal is not marriage. Missing names and links do not imply that no such relatives existed.</p>
    </>
  ) : <p class="tree-caption">No current head has been established for this house. A family tree cannot yet be reconstructed from the recorded evidence.</p>}
</section>
<style>
.orr-knowledge-tree { padding:1rem; overflow-wrap:anywhere; }
.tree-caption { font:italic .85rem Georgia,serif; color:#856a4e; margin:.25rem 0 .75rem; }
.tree-primary { display:grid; gap:.8rem; padding:.75rem; text-align:center; }
.tree-focus { display:flex; justify-content:center; }
.tree-tier { display:grid; gap:.35rem; justify-items:center; }
.tree-label { font:italic .85rem Georgia,serif; color:#856a4e; }
.tree-nodes { display:flex; flex-wrap:wrap; justify-content:center; gap:.4rem; }
.tree-node { display:inline-block; padding:.4rem .7rem; color:#594c3f; background:#fffcf5; border:1px solid #c1ac89; border-radius:3px; font: .95rem Georgia,serif; line-height:1.35; }
a.tree-node { color:#315d77; text-decoration:none; }
a.tree-node:hover, a.tree-node:focus-visible { text-decoration:underline; }
.tree-current { font-weight:bold; background:#e8d4ae; border:2px solid #845235; color:#58331e; }
.tree-branches { margin-top:1rem; border-top:1px solid #c1ac89; padding-top:.8rem; }
.tree-branch { margin:.5rem 0; border:1px solid #c1ac89; border-radius:3px; }
.tree-branch summary { padding:.55rem .75rem; cursor:pointer; font-weight:bold; }
.tree-branch-content { display:grid; gap:.6rem; padding:.5rem .75rem .85rem; }
.tree-profile { text-align:center; font-size:.85rem; }
</style>
